{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadbox-studio-v1",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leadbox-studio",
      "database_id": "f22c23fe-77fd-409b-b030-2ad8af12d965"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/telegram/*",
      "/health"
    ]
  },
  "vars": {
    "MINI_APP_URL": "https://leadbox-studio-v1.egorstend2.workers.dev/"
  }
}
